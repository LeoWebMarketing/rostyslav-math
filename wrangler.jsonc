{
  "name": "klasno",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "klasno-db",
    "database_id": "662dbbaa-531e-40fa-a8d7-e05c0a494a79",
    "migrations_dir": "migrations"
  }],
  "vars": { "APP_ORIGIN": "https://klasno.online" },
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
  // Worker secrets: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, SESSION_PEPPER
}
